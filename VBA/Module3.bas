Attribute VB_Name = "Module3"
Sub ExportAllVBA()
    Dim vbComp As Object
    Dim exportPath As String
    Dim ext As String
    
    ' ????????? ????? VBA_Export ????? ?? ???????? ??????
    exportPath = ThisWorkbook.Path & "\VBA_Export\"
    If Dir(exportPath, vbDirectory) = "" Then MkDir exportPath
    
    For Each vbComp In ThisWorkbook.VBProject.VBComponents
        Select Case vbComp.Type
            Case 1: ext = ".bas" ' ??????????? ??????
            Case 2: ext = ".cls" ' ?????? ?????
            Case 3: ext = ".frm" ' UserForm (????? ?????????? .frx)
            Case 100: ext = ".cls" ' ??? ??????? ?? ThisWorkbook
            Case Else: ext = ""
        End Select
        
        ' ??????????? ???? ???? ? ?????? ? ???
        If ext <> "" And vbComp.CodeModule.CountOfLines > 0 Then
            vbComp.Export exportPath & vbComp.name & ext
        End If
    Next vbComp
    
    MsgBox "??????! ??? ??????? ????????? ?: " & exportPath, vbInformation
End Sub
